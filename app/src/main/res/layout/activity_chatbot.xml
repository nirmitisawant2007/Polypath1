<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"> <LinearLayout
    android:id="@+id/chat_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2E7D32"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/polypath_logo" /> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="PolyPath AI Assistant"
    android:textColor="#333333"
    android:textSize="18sp"
    android:textStyle="bold" />
</LinearLayout>

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/date_bg_rounded"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="Today"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chat_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/chat_container_bg"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/input_area"
        app:layout_constraintTop_toBottomOf="@id/tv_date" />

    <LinearLayout
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_bg_rounded"
            android:hint="Type a message..."
            android:padding="12dp"
            android:textColorHint="#999999" />

        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_send_icon"
            app:tint="@null" />

         </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>