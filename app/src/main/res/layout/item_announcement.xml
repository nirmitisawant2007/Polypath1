<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="#556B2F"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/tvAnnounceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 March 2026"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivBell"
            android:layout_toStartOf="@id/tvAnnounceDate"
            android:layout_marginStart="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tvAnnounceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Announcement Title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#556B2F" />

            <TextView
                android:id="@+id/tvAnnounceDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is the description of the announcement."
                android:textSize="14sp"
                android:layout_marginTop="5dp"
                android:textColor="#333333" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>